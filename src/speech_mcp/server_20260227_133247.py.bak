import os
import tempfile
import logging
import asyncio
from datetime import datetime, timedelta
from contextlib import asynccontextmanager
from pathlib import Path
from typing import Optional, Dict, List

import anyio
import pyttsx3
import uvicorn
from dotenv import load_dotenv
from elevenlabs.client import ElevenLabs
from fastapi import FastAPI, WebSocket, WebSocketDisconnect
from fastapi.middleware.cors import CORSMiddleware
from fastmcp import Context, FastMCP
from hume import HumeClient

from speech_mcp.rag.vector_store import DocumentStore

# Load environment variables
load_dotenv()
HUME_API_KEY = os.getenv("HUME_API_KEY")
ELEVENLABS_API_KEY = os.getenv("ELEVENLABS_API_KEY")

# Global State
_store: Optional[DocumentStore] = None
_timers: Dict[str, asyncio.Task] = {}
_alarms: List[Dict] = []


def get_store() -> DocumentStore:
    """Lazy-initialization for DocumentStore."""
    global _store
    if _store is None:
        db_path = Path("data/lancedb")
        db_path.parent.mkdir(parents=True, exist_ok=True)
        _store = DocumentStore(db_path)
    return _store


@asynccontextmanager
async def lifespan(app: FastAPI):
    """
    Handle initialization and cleanup.
    """
    # Pre-warm the store
    get_store()
    yield
    # Cleanup timers
    for task in _timers.values():
        task.cancel()


# Initialize FastAPI
app = FastAPI(title="Speech MCP Stream Gateway", lifespan=lifespan)

# CORS
app.add_middleware(
    CORSMiddleware,
    allow_origins=["http://localhost:10761", "http://127.0.0.1:10761"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# FastMCP
mcp = FastMCP("speech-mcp", lifespan=lifespan)

# Clients
hume_client = HumeClient(api_key=HUME_API_KEY) if HUME_API_KEY else None
eleven_client = ElevenLabs(api_key=ELEVENLABS_API_KEY) if ELEVENLABS_API_KEY else None

# --- API Routes ---


@app.get("/api/v1/health")
async def health_check():
    return {
        "status": "healthy",
        "mcp_server": "online",
        "rag_sources": get_store().list_sources(),
        "active_timers": len(_timers),
        "providers": {
            "hume": bool(hume_client),
            "elevenlabs": bool(eleven_client),
            "windows": True,
        },
    }


@app.get("/api/v1/search")
async def api_search(q: str = ""):
    results = get_store().search(q, limit=10)
    return [
        {
            "filename": r["metadata"].get("filename", "unknown"),
            "score": max(0.0, 1.0 - r.get("_distance", 0.0)),
            "content": r["content"],
        }
        for r in results
    ]


# --- Domestic Utility Helpers ---


async def run_timer(timer_id: str, seconds: int, label: str):
    try:
        await asyncio.sleep(seconds)
        # In a real app, this would trigger a notification or OSC message
        print(f"TIMER EXPIRED: {label}")
        if timer_id in _timers:
            del _timers[timer_id]
    except asyncio.CancelledError:
        pass


# --- MCP Tools ---


@mcp.tool()
async def text_to_speech(
    text: str,
    voice_id: str = "ito",
    provider: str = "hume",
    Emotion: str | None = None,
    ctx: Context = None,
) -> dict:
    """Expressive TTS via Hume, ElevenLabs, or Windows Local."""
    if ctx:
        ctx.info(f"TTS: {text[:30]}...")
    stream_url = f"ws://localhost:10760/ws/stream?provider={provider}&voice={voice_id}"
    return {"success": True, "stream_url": stream_url, "provider": provider}


@mcp.tool()
async def manage_domestic_utility(
    action: str,
    type: str,
    value: str | int | None = None,
    label: str = "Default",
    ctx: Context = None,
) -> dict:
    """
    ALEXA PATTERN: Manages timers, alarms, and utility queries.

    Args:
        action (str): 'set', 'cancel', 'query'.
        type (str): 'timer', 'alarm', 'weather'.
        value (str | int): Duration in seconds for timer, or time string for alarm.
    """
    if ctx:
        ctx.info(f"Domestic Utility: {action} {type} ({label})")

    if type == "timer":
        if action == "set":
            timer_id = f"timer_{label}_{datetime.now().timestamp()}"
            seconds = int(value) if value else 60
            task = asyncio.create_task(run_timer(timer_id, seconds, label))
            _timers[timer_id] = task
            return {
                "success": True,
                "timer_id": timer_id,
                "expires_in": seconds,
                "status": "active",
            }
        elif action == "query":
            return {"success": True, "active_timers": len(_timers)}

    elif type == "weather":
        # Mock weather bridge
        return {
            "success": True,
            "location": label,
            "condition": "Cloudy with a chance of data",
            "temp": "21°C",
            "recommendation": "Wear a reductionist coat.",
        }

    return {"success": False, "error": "Action/Type combination not implemented"}


@mcp.tool()
async def trigger_action(
    action_type: str, params: dict = None, ctx: Context = None
) -> dict:
    """
    ELICITED ACTION: Physical effects (Lights/IoT) or UI notifications.
    Standardized to handle 'devices-mcp' style orchestration.
    """
    if ctx:
        ctx.info(f"Eliciting action: {action_type}")

    # Logic for devices-mcp bridge (lights on/off)
    if action_type in ["light_on", "light_off"]:
        room = params.get("room", "living_room")
        return {
            "success": True,
            "device": "Tapo Smart Bulb",
            "room": room,
            "state": "on" if "on" in action_type else "off",
        }

    return {"success": True, "action_elicited": action_type, "status": "triggered"}


@mcp.tool()
def search_docs(query: str, limit: int = 5) -> dict:
    """Semantic RAG search."""
    results = get_store().search(query, limit=limit)
    return {
        "success": True,
        "data": [
            {
                "filename": r["metadata"].get("filename", "unknown"),
                "score": max(0.0, 1.0 - r.get("_distance", 0.0)),
                "content": r["content"],
            }
            for r in results
        ],
    }


@mcp.tool()
async def ask_docs(question: str, ctx: Context) -> dict:
    """Ask complex questions about speech AI (RAG)."""
    search_result = search_docs(question, limit=8)
    if not search_result["success"]:
        return search_result
    context_text = "\n\n".join(
        [
            f"SOURCE: {r['filename']}\nCONTENT: {r['content']}"
            for r in search_result["data"]
        ]
    )
    response = await ctx.session.create_message(
        messages=[
            {
                "role": "user",
                "content": {
                    "type": "text",
                    "text": f"Context:\n{context_text}\n\nQuestion: {question}",
                },
            }
        ],
        system_prompt="You are a SOTA speech technology expert. Answer based on context.",
    )
    return {
        "success": True,
        "answer": response.content.text
        if hasattr(response.content, "text")
        else str(response.content),
    }


# --- WebSocket & Startup ---


@app.websocket("/ws/stream")
async def websocket_stream(websocket: WebSocket):
    await websocket.accept()
    provider = websocket.query_params.get("provider", "hume")
    voice_id = websocket.query_params.get("voice", "ito")
    try:
        while True:
            # Simplified binary proxy for now
            data = await websocket.receive_bytes()
            await websocket.send_bytes(data)
    except WebSocketDisconnect:
        pass


if __name__ == "__main__":
    mcp_app = mcp.http_app(transport="sse")
    app.mount("/mcp", mcp_app)
    uvicorn.run(app, host="0.0.0.0", port=10760)
