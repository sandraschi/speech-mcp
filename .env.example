# Speech MCP Environment Configuration
# Copy this file to .env and fill in your keys

# --- SECURITY ---
# Security token for developer login. CHANGE THIS - the old default was 'admin'.
SPEECH_MCP_AUTH_TOKEN=change-me

# --- HUME AI (EVI & TTS) ---
# Get your API Key from https://beta.hume.ai/
HUME_API_KEY=your_hume_api_key_here
# Get your Secret Key if required (for some operations)
# HUME_SECRET_KEY=
# Default EVI Config ID
HUME_CONFIG_ID=your_evi_config_id_here

# --- ELEVENLABS (TTS & Cloning) ---
# Get your API Key from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# --- NETWORK ---
# Port for the Speech MCP backend (default: 10909)
SPEECH_MCP_PORT=10909

# --- Fleet Voice Command Bus (wake → STT → fleet-agent) ---
# FLEET_VOICE_DELEGATE=1
# FLEET_VOICE_ROUTER_URL=http://127.0.0.1:10996/api/voice/intent
# FLEET_VOICE_WAKE_KEYWORD=hey_jarvis
# FLEET_VOICE_COMMAND_SECONDS=6
# FLEET_VOICE_AUTOSTART=1
# FLEET_VOICE_WAKE_GREETING=Hello, mistress.
# FLEET_VOICE_SLEEP_KEYWORD=hey_mycroft
# FLEET_VOICE_SPEAK_REPLY=1
# MCP Bridge: comma-separated SSE URLs to proxy tools from other MCP servers
# MCP_BRIDGE_URLS=http://127.0.0.1:10807/mcp,http://127.0.0.1:10782/mcp
# Host for OSC communication (default: 127.0.0.1)
OSC_HOST=127.0.0.1
# Port for OSC communication (default: 9000 for VRChat)
OSC_PORT=9000

# --- FUNASR (Local STT — Alibaba Fun-ASR MLT-Nano / SenseVoice) ---
# Enable native in-process inference (requires: uv sync --extra funasr)
FUNASR_ENABLED=false
# Multilingual streaming model — 31 languages incl. English, Japanese, German
# (requires funasr>=1.4.1). Language is auto-detected; set FUNASR_LANGUAGE to
# force e.g. "英文" (en), "日文" (ja), "德文" (de).
FUNASR_MODEL=FunAudioLLM/Fun-ASR-MLT-Nano-2512
# cuda:0 for GPU, cpu for airgapped/secondary boards
FUNASR_DEVICE=cuda:0
# hf = HuggingFace, ms = ModelScope
FUNASR_HUB=hf
FUNASR_VAD_MODEL=fsmn-vad
FUNASR_PUNC_MODEL=ct-punc
FUNASR_SPK_MODEL=cam++
# Alternative: OpenAI-compatible sidecar (zero Python deps in speech-mcp)
# Start sidecar: uv run python scripts/start_funasr_sidecar.py
# FUNASR_OPENAI_URL=http://127.0.0.1:10914/v1

# --- SHERPA-ONNX (Streaming STT — Japanese/English/German, CPU, barge-in) ---
# Streaming online ASR with Silero VAD. Models: Japanese/English via a
# multilingual zipformer, German via de-kroko. Requires: uv sync --extra sherpa
# Download models first: uv run python scripts/download_sherpa_models.py
# SHERPA_ASR_ENABLED=true
# SHERPA_ASR_LANG=en        # en | ja | de
# SHERPA_BARGE_IN=true      # endpoint-based barge-in (interrupt while assistant speaks)
# SHERPA_MODEL_DIR=         # default: models/sherpa-onnx
# SHERPA_NUM_THREADS=2
# SHERPA_PROVIDER=          # e.g. cpu, cuda (default: onnxruntime default)
