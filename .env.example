# Speech MCP Environment Configuration
# Copy this file to .env and fill in your keys

# --- SECURITY ---
# Security token for developer login (default: admin)
SPEECH_MCP_AUTH_TOKEN=admin

# --- HUME AI (EVI & TTS) ---
# Get your API Key from https://beta.hume.ai/
HUME_API_KEY=your_hume_api_key_here
# Get your Secret Key if required (for some operations)
# HUME_SECRET_KEY=
# Default EVI Config ID
HUME_CONFIG_ID=your_evi_config_id_here

# --- ELEVENLABS (TTS & Cloning) ---
# Get your API Key from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# --- NETWORK ---
# Port for the Speech MCP backend (default: 10909)
SPEECH_MCP_PORT=10909
# MCP Bridge: comma-separated SSE URLs to proxy tools from other MCP servers
# MCP_BRIDGE_URLS=http://127.0.0.1:10807/mcp,http://127.0.0.1:10782/mcp
# Host for OSC communication (default: 127.0.0.1)
OSC_HOST=127.0.0.1
# Port for OSC communication (default: 9000 for VRChat)
OSC_PORT=9000
