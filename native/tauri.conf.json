{
  "productName": "Speech MCP",
  "version": "0.6.4",
  "identifier": "ai.fleet.speech-mcp",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://127.0.0.1:10908",
    "beforeDevCommand": "npm --prefix ../web run dev"
  },
  "app": {
    "windows": [
      {
        "title": "Speech MCP",
        "label": "main",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/speech-mcp-backend.exe",
            "resources/.env.example"
    ],
    "targets": [
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
"installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "process": {
      "all": true
    }
  }
}
