{
    "name": "speech-mcp",
    "version": "0.2.1",
    "description": "SOTA-grade MCP server for multi-provider voice orchestration (Hume AI + ElevenLabs + Windows TTS) with RAG knowledge base.",
    "homepage": "https://github.com/sandraschi/speech-mcp",
    "license": "MIT",
    "keywords": [
        "mcp",
        "speech",
        "tts",
        "hume-ai",
        "elevenlabs",
        "rag",
        "agentic",
        "fastmcp"
    ],
    "mcp": {
        "transport": "stdio",
        "command": "python",
        "args": [
            "-m",
            "speech_mcp.server"
        ],
        "env": [
            "HUME_API_KEY",
            "HUME_CONFIG_ID",
            "ELEVENLABS_API_KEY"
        ]
    },
    "tools": [
        {
            "name": "text_to_speech",
            "description": "Synthesize speech via Hume AI, ElevenLabs, or Windows Local TTS. Returns a WebSocket stream URL for audio consumption."
        },
        {
            "name": "manage_domestic_utility",
            "description": "Alexa-style domestic utility gateway: set/cancel/query timers, query weather, and schedule alarms."
        },
        {
            "name": "trigger_action",
            "description": "Elicit physical effects via IoT bridge (Tapo smart lights) or trigger UI notifications."
        },
        {
            "name": "search_docs",
            "description": "Semantic RAG search over the speech-mcp knowledge base (LanceDB + FastEmbed)."
        },
        {
            "name": "ask_docs",
            "description": "Ask complex questions about speech AI. Uses RAG retrieval + LLM sampling (ctx.sample) for grounded answers."
        }
    ],
    "runtime": "python>=3.11",
    "capabilities": {
        "sampling": true,
        "dialogic_returns": true,
        "rag": true,
        "agentic_workflows": true
    }
}
